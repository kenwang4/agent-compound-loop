{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kenwang4/agent-compound-loop/schemas/task-envelope.v1.json",
  "title": "TaskEnvelope",
  "description": "Minimal traceable task envelope. Do not store prompts, chain-of-thought, secrets, or full model replies.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "risk",
    "owner",
    "host",
    "machine",
    "session_id",
    "agent_id",
    "agent_type",
    "artifact",
    "acceptance",
    "verdict",
    "status",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n]+$"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "host": {
      "type": "string",
      "enum": [
        "cursor",
        "claude",
        "codex",
        "script",
        "other"
      ]
    },
    "machine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "agent_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "artifact": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^(?!/)(?!~)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]*$"
    },
    "acceptance": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?:ref:[^\\r\\n]{1,240}|acceptance_sha256:[0-9a-f]{16}|acceptance:redacted)?$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "revise",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "blocked"
      ]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500,
        "pattern": "^(?!/)(?!~)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]*$"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "risk": {
            "const": "high"
          },
          "status": {
            "const": "completed"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "revise"
            ]
          }
        },
        "required": [
          "risk",
          "status",
          "verdict"
        ]
      },
      "then": {
        "required": [
          "evidence_refs"
        ],
        "properties": {
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
